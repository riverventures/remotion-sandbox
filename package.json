{
  "name": "remotion-sandbox",
  "version": "1.0.0",
  "description": "A sandbox for testing Remotion animations",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render HelloWorld out/hello-world.mp4",
    "render:gif": "remotion render HelloWorld out/hello-world.gif",
    "render:still": "remotion still HelloWorld out/hello-world.png --frame=30",
    "render:logo": "remotion render LogoAnimation out/logo-animation.mp4",
    "render:shapes": "remotion render ColorfulShapes out/colorful-shapes.mp4",
    "render:all": "npm run render && npm run render:logo && npm run render:shapes"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
